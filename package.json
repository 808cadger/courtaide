{
  "name": "courtaide",
  "version": "1.0.0",
  "description": "CourtAide — AI Legal Assistant for Pro Se Representation",
  "main": "electron/main.js",
  "author": "Christopher Cadger <cadger808@codeberg.org>",
  "license": "UNLICENSED",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "electron-builder --linux",
    "electron:dist": "electron-builder --linux AppImage rpm",
    "cap:sync": "npx cap copy && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cadger808.courtaide",
    "productName": "CourtAide",
    "copyright": "Copyright © 2025 Christopher Cadger",
    "directories": {
      "output": "dist-electron",
      "buildResources": "icons"
    },
    "files": [
      "index.html",
      "manifest.json",
      "sw.js",
      "avatar-widget.js",
      "icons/**",
      "electron/**",
      "!node_modules/**",
      "!android/**",
      "!www/**",
      "!dist-electron/**"
    ],
    "linux": {
      "target": ["AppImage", "rpm"],
      "category": "Utility",
      "icon": "icons/icon-512.png",
      "desktop": {
        "Name": "CourtAide",
        "Comment": "AI Legal Assistant",
        "Categories": "Utility;Office"
      }
    },
    "publish": {
      "provider": "generic",
      "url": "https://codeberg.org/cadger808/courtaide/releases/download/latest/"
    }
  }
}
